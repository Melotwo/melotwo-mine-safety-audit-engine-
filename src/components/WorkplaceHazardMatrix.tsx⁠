import { 
  ShieldAlert, 
  AlertTriangle, 
  CheckCircle2, 
  Zap, 
  Flame, 
  ShieldCheck, 
  Activity, 
  Sparkles, 
  ArrowRight, 
  Check, 
  Truck, 
  Eye, 
  Settings, 
  AlertOctagon, 
  Info, 
  RotateCcw,
  Sliders,
  XCircle
} from 'lucide-react';

export type HazardStatus = 'pass' | 'risk_detected' | 'critical';

export interface HazardCategoryItem {
  id: string;
  name: string;
  code: string;
  standardRef: string;
  isHighRisk?: boolean;
  iconName: string;
  defaultDescription: string;
  mitigationAction: string;
}

