// Mine Safety Audit Engine - Workplace Hazard Assessment Matrix
import React, { useState, useEffect } from 'react';
import { 
  ShieldAlert, 
  AlertTriangle, 
  CheckCircle2, 
  Zap, 
  Flame, 
  ShieldCheck, 
  Activity, 
  Sparkles, 
  ArrowRight, 
  Check, 
  Truck, 
  Eye, 
  Settings, 
  AlertOctagon, 
  Info, 
  RotateCcw,
  Sliders,
  XCircle
} from 'lucide-react';

export type HazardStatus = 'pass' | 'risk_detected' | 'critical';

export interface HazardCategoryItem {
  id: string;
  name: string;
  code: string;
  standardRef: string;
  isHighRisk?: boolean;
  iconName: string;
  defaultDescription: string;
  mitigationAction: string;
}

export const HAZARD_CATEGORIES: HazardCategoryItem[] = [
  {
    id: 'slips_trips',
    name: 'Slips, Trips & Falls',
    code: 'HAZ-STF',
    standardRef: 'SANS 10338 / OHS Sec 8',
    iconName: 'Activity',
    defaultDescription: 'Walkways, ladders, anti-slip decking & 2m+ edge protection.',
    mitigationAction: 'Clear oil spillages on walkway grids, anchor loose floor plates, and enforce double-lanyard fall protection above 2.0m.'
  },
  {
    id: 'moving_machinery',
    name: 'Moving Machinery & Pinch Points',
    code: 'HAZ-MMP',
    standardRef: 'MHSA Reg 8.8 / ISO 13857',
    isHighRisk: true,
    iconName: 'Settings',
    defaultDescription: 'Conveyor nip-points, tail-pulleys, drive couplings & rotating shafts.',
    mitigationAction: 'Verify physical interlocked wire mesh guards are bolted in place and trip wires are fully operational along the conveyor belt length.'
  },
  {
    id: 'electrical',
    name: 'Electrical Isolation & LOTO',
    code: 'HAZ-ELE',
    standardRef: 'SANS 10142 / MHSA Reg 3.1',
    isHighRisk: true,
    iconName: 'Zap',
    defaultDescription: 'MCC switchgear panels, trailing cables, transformer bays & earthing.',
    mitigationAction: 'Execute zero-energy verification before opening switchgear, apply personal padlock, and ensure trailing cable insulation is free of cracks.'
  },
  {
    id: 'air_quality',
    name: 'Dust, Gas & Ventilation',
    code: 'HAZ-ENV',
    standardRef: 'MHSA Reg 9.2 (OEL limits)',
    isHighRisk: true,
    iconName: 'Flame',
    defaultDescription: 'Silica dust suppression, methane accumulation & scrubber sprays.',
    mitigationAction: 'Activate water misting sprayers on transfer chutes, measure airflow velocity (>0.5 m/s required), and verify multi-gas detector calibration.'
  },
  {
    id: 'mobile_equipment',
    name: 'TMM & Mobile Equipment Traffic',
    code: 'HAZ-TMM',
    standardRef: 'MHSA Reg 8.9 (PDS Mandate)',
    isHighRisk: true,
    iconName: 'Truck',
    defaultDescription: 'Haul truck traffic lanes, pedestrian berms, proximity detection & brakes.',
    mitigationAction: 'Test Proximity Detection System (PDS) warning zones, verify 1.5m safety berm height, and perform pre-start brake hold tests.'
  },
  {
    id: 'illumination',
    name: 'Lighting & Visual Inspection',
    code: 'HAZ-LGT',
    standardRef: 'SANS 10114 / OHS Sec 9',
    iconName: 'Eye',
    defaultDescription: 'Substation lux levels, high-mast floodlights & emergency egress marking.',
    mitigationAction: 'Replace blown LED floodlights along catwalks to maintain minimum 50 lux standard and clean dust buildup off reflector lenses.'
  }
];

export interface HazardEvaluationState {
  status: HazardStatus;
  notes: string;
  customMitigation?: string;
}

export interface WorkplaceHazardMatrixProps {
  onMatrixEvaluated?: (summary: {
    totalEvaluated: number;
    criticalCount: number;
    riskCount: number;
    passCount: number;
    evaluatedItems: Record<string, HazardEvaluationState>;
  }) => void;
  readOnly?: boolean;
}

export const WorkplaceHazardMatrix: React.FC<WorkplaceHazardMatrixProps> = ({
  onMatrixEvaluated,
  readOnly = false
}) => {
  const [evaluations, setEvaluations] = useState<Record<string, HazardEvaluationState>>(() => {
    // Default initial state: all passing
    const initial: Record<string, HazardEvaluationState> = {};
    HAZARD_CATEGORIES.forEach(cat => {
      initial[cat.id] = {
        status: 'pass',
        notes: ''
      };
    });
    return initial;
  });

  const [activeCategory, setActiveCategory] = useState<string>(HAZARD_CATEGORIES[0].id);

  // Compute total summary metrics
  const stats = Object.values(evaluations).reduce(
    (acc, item) => {
      acc.total++;
      if (item.status === 'critical') acc.critical++;
      else if (item.status === 'risk_detected') acc.risk++;
      else acc.pass++;
      return acc;
    },
    { total: 0, critical: 0, risk: 0, pass: 0 }
  );

  const handleStatusChange = (categoryId: string, newStatus: HazardStatus) => {
    if (readOnly) return;
    setEvaluations(prev => {
      const next = {
        ...prev,
        [categoryId]: {
          ...prev[categoryId],
          status: newStatus
        }
      };
      
      if (onMatrixEvaluated) {
        const criticalCount = Object.values(next).filter(i => i.status === 'critical').length;
        const riskCount = Object.values(next).filter(i => i.status === 'risk_detected').length;
        const passCount = Object.values(next).filter(i => i.status === 'pass').length;
        onMatrixEvaluated({
          totalEvaluated: Object.keys(next).length,
          criticalCount,
          riskCount,
          passCount,
          evaluatedItems: next
        });
      }

      return next;
    });
  };

  const handleNotesChange = (categoryId: string, text: string) => {
    if (readOnly) return;
    setEvaluations(prev => ({
      ...prev,
      [categoryId]: {
        ...prev[categoryId],
        notes: text
      }
    }));
  };

  const resetAll = () => {
    if (readOnly) return;
    const resetState: Record<string, HazardEvaluationState> = {};
    HAZARD_CATEGORIES.forEach(cat => {
      resetState[cat.id] = { status: 'pass', notes: '' };
    });
    setEvaluations(resetState);
    if (onMatrixEvaluated) {
      onMatrixEvaluated({
        totalEvaluated: HAZARD_CATEGORIES.length,
        criticalCount: 0,
        riskCount: 0,
        passCount: HAZARD_CATEGORIES.length,
        evaluatedItems: resetState
      });
    }
  };

  const activeCategoryItem = HAZARD_CATEGORIES.find(c => c.id === activeCategory) || HAZARD_CATEGORIES[0];
  const activeEval = evaluations[activeCategoryItem.id] || { status: 'pass', notes: '' };

  return (
    <div className="bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl text-slate-100">
      {/* Header */}
      <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-6 border-b border-slate-800">
        <div>
          <div className="flex items-center gap-2 mb-1">
            <ShieldAlert className="w-6 h-6 text-amber-400" />
            <h3 className="text-xl font-bold tracking-tight text-white">Workplace Hazard Assessment Matrix</h3>
            <span className="px-2.5 py-0.5 text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20 rounded-full">
              MHSA / SANS Standard
            </span>
          </div>
          <p className="text-xs text-slate-400">
            Interactive risk inspection panel for high-hazard mining working places. Evaluate conditions to generate compliant COP corrective controls.
          </p>
        </div>

        {!readOnly && (
          <button
            onClick={resetAll}
            className="flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-400 hover:text-white bg-slate-800 hover:bg-slate-700 rounded-lg transition-colors border border-slate-700"
          >
            <RotateCcw className="w-3.5 h-3.5" />
            Reset Matrix
          </button>
        )}
      </div>

      {/* Summary Score Bar */}
      <div className="grid grid-cols-3 gap-3 my-6">
        <div className="bg-emerald-950/30 border border-emerald-800/40 rounded-xl p-3 flex items-center justify-between">
          <div>
            <span className="text-xs text-emerald-400 font-medium block">Compliant / Low Risk</span>
            <span className="text-xl font-extrabold text-emerald-300">{stats.pass} <span className="text-xs font-normal text-slate-400">/ {stats.total}</span></span>
          </div>
          <CheckCircle2 className="w-6 h-6 text-emerald-400/80" />
        </div>

        <div className="bg-amber-950/30 border border-amber-800/40 rounded-xl p-3 flex items-center justify-between">
          <div>
            <span className="text-xs text-amber-400 font-medium block">Minor Hazard / Warning</span>
            <span className="text-xl font-extrabold text-amber-300">{stats.risk} <span className="text-xs font-normal text-slate-400">/ {stats.total}</span></span>
          </div>
          <AlertTriangle className="w-6 h-6 text-amber-400/80" />
        </div>

        <div className="bg-rose-950/30 border border-rose-800/40 rounded-xl p-3 flex items-center justify-between">
          <div>
            <span className="text-xs text-rose-400 font-medium block">Critical Violation / Stop Work</span>
            <span className="text-xl font-extrabold text-rose-300">{stats.critical} <span className="text-xs font-normal text-slate-400">/ {stats.total}</span></span>
          </div>
          <ShieldAlert className="w-6 h-6 text-rose-400/80" />
        </div>
      </div>

      {/* Category Tabs */}
      <div className="flex gap-2 overflow-x-auto pb-2 mb-6 scrollbar-thin scrollbar-thumb-slate-800">
        {HAZARD_CATEGORIES.map(cat => {
          const evalItem = evaluations[cat.id];
          const isActive = cat.id === activeCategory;
          
          let statusBadgeColor = 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20';
          if (evalItem?.status === 'critical') {
            statusBadgeColor = 'bg-rose-500/20 text-rose-400 border-rose-500/40';
          } else if (evalItem?.status === 'risk_detected') {
            statusBadgeColor = 'bg-amber-500/20 text-amber-400 border-amber-500/40';
          }

          return (
            <button
              key={cat.id}
              onClick={() => setActiveCategory(cat.id)}
              className={`flex items-center gap-2.5 px-3.5 py-2.5 rounded-xl text-xs font-semibold whitespace-nowrap transition-all border ${
                isActive
                  ? 'bg-slate-800 text-white border-amber-500/50 shadow-md'
                  : 'bg-slate-900/60 text-slate-400 hover:text-slate-200 border-slate-800 hover:border-slate-700'
              }`}
            >
              <span>{cat.name}</span>
              <span className={`px-1.5 py-0.5 rounded text-[10px] uppercase font-bold border ${statusBadgeColor}`}>
                {evalItem?.status === 'critical' ? 'CRITICAL' : evalItem?.status === 'risk_detected' ? 'WARNING' : 'PASS'}
              </span>
            </button>
          );
        })}
      </div>

      {/* Active Category Detail Panel */}
      {activeCategoryItem && (
        <div className="bg-slate-950/60 border border-slate-800 rounded-xl p-5 space-y-5">
          <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 pb-4 border-b border-slate-800/80">
            <div>
              <div className="flex items-center gap-2">
                <h4 className="text-base font-bold text-white">{activeCategoryItem.name}</h4>
                <span className="text-xs font-mono text-amber-400 bg-amber-950/40 border border-amber-800/50 px-2 py-0.5 rounded">
                  {activeCategoryItem.code}
                </span>
                {activeCategoryItem.isHighRisk && (
                  <span className="text-[10px] font-bold tracking-wider uppercase text-rose-400 bg-rose-950/60 border border-rose-800/60 px-2 py-0.5 rounded">
                    High Risk Mandate
                  </span>
                )}
              </div>
              <p className="text-xs text-slate-400 mt-1">
                Standard Reference: <span className="text-slate-300 font-mono">{activeCategoryItem.standardRef}</span>
              </p>
            </div>

            {/* Status Selector Buttons */}
            {!readOnly && (
              <div className="flex items-center gap-1.5 bg-slate-900 p-1 rounded-xl border border-slate-800">
                <button
                  type="button"
                  onClick={() => handleStatusChange(activeCategoryItem.id, 'pass')}
                  className={`flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold transition-all ${
                    activeEval.status === 'pass'
                      ? 'bg-emerald-600 text-white shadow-sm'
                      : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800'
                  }`}
                >
                  <CheckCircle2 className="w-3.5 h-3.5" />
                  Pass / Compliant
                </button>

                <button
                  type="button"
                  onClick={() => handleStatusChange(activeCategoryItem.id, 'risk_detected')}
                  className={`flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold transition-all ${
                    activeEval.status === 'risk_detected'
                      ? 'bg-amber-600 text-white shadow-sm'
                      : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800'
                  }`}
                >
                  <AlertTriangle className="w-3.5 h-3.5" />
                  Minor Risk
                </button>

                <button
                  type="button"
                  onClick={() => handleStatusChange(activeCategoryItem.id, 'critical')}
                  className={`flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-bold transition-all ${
                    activeEval.status === 'critical'
                      ? 'bg-rose-600 text-white shadow-sm'
                      : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800'
                  }`}
                >
                  <ShieldAlert className="w-3.5 h-3.5" />
                  Critical Hazard
                </button>
              </div>
            )}
          </div>

          {/* Description & Recommended Mitigation */}
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div className="bg-slate-900/80 p-3.5 rounded-xl border border-slate-800/80">
              <span className="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">
                Inspection Focus Scope
              </span>
              <p className="text-xs text-slate-300 leading-relaxed">
                {activeCategoryItem.defaultDescription}
              </p>
            </div>

            <div className={`p-3.5 rounded-xl border ${
              activeEval.status === 'critical'
                ? 'bg-rose-950/20 border-rose-800/40 text-rose-200'
                : activeEval.status === 'risk_detected'
                ? 'bg-amber-950/20 border-amber-800/40 text-amber-200'
                : 'bg-emerald-950/20 border-emerald-800/40 text-emerald-200'
            }`}>
              <span className="text-xs font-semibold uppercase tracking-wider block mb-1 opacity-80">
                Required Mitigation & COP Action
              </span>
              <p className="text-xs leading-relaxed">
                {activeCategoryItem.mitigationAction}
              </p>
            </div>
          </div>

          {/* Inspector Field Observation Notes */}
          {!readOnly && (
            <div>
              <label className="block text-xs font-medium text-slate-300 mb-1.5">
                Specific Workplace Observations & Location Tag:
              </label>
              <textarea
                value={activeEval.notes}
                onChange={(e) => handleNotesChange(activeCategoryItem.id, e.target.value)}
                placeholder={`e.g., Shaft 3 - Substation B: Conveyor tail pulley mesh guard latch broken. Temporary barrier erected.`}
                rows={2}
                className="w-full bg-slate-900 border border-slate-800 rounded-xl p-3 text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500/50 resize-none"
              />
            </div>
          )}
        </div>
      )}
    </div>
  );
};

export default WorkplaceHazardMatrix;
