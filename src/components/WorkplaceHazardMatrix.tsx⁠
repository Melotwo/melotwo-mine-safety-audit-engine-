// Mine Safety Audit Engine - Workplace Hazard Assessment Matrix
import React, { useState, useEffect } from 'react';
import { 
  ShieldAlert, 
  AlertTriangle, 
  CheckCircle2, 
  Zap, 
  Flame, 
  ShieldCheck, 
  Activity, 
  Sparkles, 
  ArrowRight, 
  Check, 
  Truck, 
  Eye, 
  Settings, 
  AlertOctagon, 
  Info, 
  RotateCcw,
  Sliders,
  XCircle
} from 'lucide-react';

export type HazardStatus = 'pass' | 'risk_detected' | 'critical';

export interface HazardCategoryItem {
  id: string;
  name: string;
  code: string;
  standardRef: string;
  isHighRisk?: boolean;
  iconName: string;
  defaultDescription: string;
  mitigationAction: string;
}

export const HAZARD_CATEGORIES: HazardCategoryItem[] = [
  {
    id: 'slips_trips',
    name: 'Slips, Trips & Falls',
    code: 'HAZ-STF',
    standardRef: 'SANS 10338 / OHS Sec 8',
    iconName: 'Activity',
    defaultDescription: 'Walkways, ladders, anti-slip decking & 2m+ edge protection.',
    mitigationAction: 'Clear oil spillages on walkway grids, anchor loose floor plates, and enforce double-lanyard fall protection above 2.0m.'
  },
  {
    id: 'fire_thermal',
    name: 'Fire & Thermal Safety',
    code: 'HAZ-FTS',
    standardRef: 'MHSA Sec 2.1 / SANS 10105',
    isHighRisk: true,
    iconName: 'Flame',
    defaultDescription: 'Fire suppression systems, hot work permits & emergency exits.',
    mitigationAction: 'Inspect fire extinguisher pressure gauges, clear blocked emergency egress, and verify hot work permits at conveyor belt junction.'
  },
  {
    id: 'electrical',
    name: 'Electrical & Isolation (LOTO)',
    code: 'HAZ-ELE',
    standardRef: 'MOSH LOTO Mandate / SANS 10142',
    isHighRisk: true,
    iconName: 'Zap',
    defaultDescription: 'Lockout/Tagout procedures, substation doors & trailing cables.',
    mitigationAction: 'Enforce LOTO on primary crusher circuit, lock MV distribution kiosk, and replace frayed trailing cable on Shuttle B.'
  },
  {
    id: 'chemical',
    name: 'Hazardous Chemical Substances',
    code: 'HAZ-HCS',
    standardRef: 'SANS 10234 GHS / SDS',
    isHighRisk: true,
    iconName: 'ShieldAlert',
    defaultDescription: 'GHS labeling, secondary bunds, SDS sheets & eyewash stations.',
    mitigationAction: 'Update SDS binder at chemical dosing unit, flush emergency eyewash station, and repair secondary bund drainage valve.'
  },
  {
    id: 'ergonomic',
    name: 'Ergonomic Hazards',
    code: 'HAZ-ERG',
    standardRef: 'OHS Environmental Regs',
    iconName: 'Eye',
    defaultDescription: 'Cabin seat vibration damping, lux levels & acoustic barriers.',
    mitigationAction: 'Replace worn seat shock absorbers on Hauler #4, increase lighting lux levels in dark transfer towers, and issue 32dB ear defenders.'
  },
  {
    id: 'transport',
    name: 'Transport & Mobile Equipment',
    code: 'HAZ-TME',
    standardRef: 'DMRE Chap 8 / PDS Mandate',
    isHighRisk: true,
    iconName: 'Truck',
    defaultDescription: 'Proximity Detection Systems (PDS), brake tests & haul road bunds.',
    mitigationAction: 'Calibrate PDS sensor on Loader #12, conduct dynamic brake test on CAT 777 fleet, and raise berm height to 1.5x tire diameter.'
  }
];

export interface WorkplaceHazardMatrixProps {
  onHazardStateChange?: (states: Record<string, HazardStatus>, criticalCount: number, penalty: number) => void;
  onApplyCorrectiveActions?: (actionsSummary: string) => void;
}

export const WorkplaceHazardMatrix: React.FC<WorkplaceHazardMatrixProps> = ({
  onHazardStateChange,
  onApplyCorrectiveActions
}) => {
  const [hazardStates, setHazardStates] = useState<Record<string, HazardStatus>>(() => {
    try {
      const saved = localStorage.getItem('melotwo_hazard_matrix_states');
      if (saved) return JSON.parse(saved);
    } catch {
      // ignore
    }
    const initial: Record<string, HazardStatus> = {};
    HAZARD_CATEGORIES.forEach(h => {
      initial[h.id] = 'pass';
    });
    return initial;
  });

  const [copiedNotification, setCopiedNotification] = useState(false);

  useEffect(() => {
    try {
      localStorage.setItem('melotwo_hazard_matrix_states', JSON.stringify(hazardStates));
    } catch {
      // ignore
    }

    let criticalCount = 0;
    let riskCount = 0;
    Object.values(hazardStates).forEach(st => {
      if (st === 'critical') criticalCount++;
      if (st === 'risk_detected') riskCount++;
    });

    const scorePenalty = (criticalCount * 12) + (riskCount * 5);

    if (onHazardStateChange) {
      onHazardStateChange(hazardStates, criticalCount, scorePenalty);
    }
  }, [hazardStates, onHazardStateChange]);

  const handleSetStatus = (id: string, status: HazardStatus) => {
    setHazardStates(prev => ({
      ...prev,
      [id]: status
    }));
  };

  const handleResetAll = () => {
    const initial: Record<string, HazardStatus> = {};
    HAZARD_CATEGORIES.forEach(h => {
      initial[h.id] = 'pass';
    });
    setHazardStates(initial);
  };

  const flaggedHazards = HAZARD_CATEGORIES.filter(
    h => hazardStates[h.id] === 'risk_detected' || hazardStates[h.id] === 'critical'
  );

  const handleApplyActions = () => {
    if (flaggedHazards.length === 0) return;

    const summaryText = flaggedHazards.map(h => 
      `[${h.code} DIRECTIVE] ${h.name}: ${h.mitigationAction}`
    ).join('\n');

    if (onApplyCorrectiveActions) {
      onApplyCorrectiveActions(summaryText);
      setCopiedNotification(true);
      setTimeout(() => setCopiedNotification(false), 2500);
    }
  };

  const criticalCount = Object.values(hazardStates).filter(s => s === 'critical').length;
  const riskCount = Object.values(hazardStates).filter(s => s === 'risk_detected').length;
  const scorePenalty = (criticalCount * 12) + (riskCount * 5);

  return (
    <div className="bg-slate-900 border border-slate-800 rounded-2xl p-5 md:p-6 text-slate-100 space-y-6 shadow-xl" id="workplace-hazard-matrix">
      <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800/80 pb-4">
        <div>
          <div className="flex items-center gap-2">
            <span className="text-[10px] font-mono font-bold tracking-wider text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/30 uppercase">
              MHSA / SANS COMPLIANCE
            </span>
            <span className="text-[10px] font-mono text-slate-400">Section 8 & 11 Mandate</span>
          </div>
          <h3 className="text-lg font-bold text-white mt-1 flex items-center gap-2">
            <Sliders className="w-5 h-5 text-amber-400" />
            Workplace Hazard Assessment Matrix
          </h3>
          <p className="text-xs text-slate-400 mt-0.5">
            Evaluate high-risk operational hazards across mine sections to auto-adjust safety compliance index.
          </p>
        </div>

        <div className="flex items-center gap-3 shrink-0">
          <div className="text-right">
            <div className="text-[11px] font-mono text-slate-400">Matrix Impact</div>
            <div className={`text-xs font-bold font-mono ${scorePenalty > 0 ? 'text-rose-400' : 'text-emerald-400'}`}>
              {scorePenalty > 0 ? `-${scorePenalty}% Penalty` : '100% Optimal'}
            </div>
          </div>
          <button
            type="button"
            onClick={handleResetAll}
            className="p-2 bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white rounded-xl text-xs font-medium border border-slate-700/60 transition-all flex items-center gap-1.5 cursor-pointer"
            title="Reset matrix status"
            id="btn-reset-hazard-matrix"
          >
            <RotateCcw className="w-3.5 h-3.5" />
            <span className="hidden sm:inline">Reset</span>
          </button>
        </div>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {HAZARD_CATEGORIES.map(h => {
          const status = hazardStates[h.id] || 'pass';

          return (
            <div 
              key={h.id}
              className={`rounded-xl border p-4 transition-all flex flex-col justify-between space-y-3 ${
                status === 'critical'
                  ? 'bg-rose-950/20 border-rose-500/60 shadow-lg shadow-rose-950/30'
                  : status === 'risk_detected'
                  ? 'bg-amber-950/20 border-amber-500/50'
                  : 'bg-slate-950/60 border-slate-800/80 hover:border-slate-700'
              }`}
              id={`hazard-card-${h.id}`}
            >
              <div className="space-y-2">
                <div className="flex items-start justify-between gap-2">
                  <span className="text-[10px] font-mono text-slate-400 bg-slate-800/80 px-2 py-0.5 rounded border border-slate-700/50">
                    {h.code}
                  </span>
                  <span className={`text-[10px] font-mono font-bold px-2 py-0.5 rounded border ${
                    status === 'critical'
                      ? 'bg-rose-500/20 border-rose-500/50 text-rose-300'
                      : status === 'risk_detected'
                      ? 'bg-amber-500/20 border-amber-500/50 text-amber-300'
                      : 'bg-emerald-500/20 border-emerald-500/50 text-emerald-300'
                  }`}>
                    {status === 'critical' ? 'CRITICAL RISK' : status === 'risk_detected' ? 'RISK DETECTED' : 'COMPLIANT'}
                  </span>
                </div>

                <div>
                  <h4 className="text-sm font-bold text-white flex items-center gap-1.5">
                    {h.name}
                  </h4>
                  <p className="text-[11px] text-slate-400 mt-1 line-clamp-2">
                    {h.defaultDescription}
                  </p>
                </div>
              </div>

              <div className="pt-2 border-t border-slate-800/60 flex items-center gap-1.5 text-[11px]">
                <button
                  type="button"
                  onClick={() => handleSetStatus(h.id, 'pass')}
                  className={`flex-1 py-1 px-2 rounded-lg font-medium border transition-all cursor-pointer flex items-center justify-center gap-1 ${
                    status === 'pass'
                      ? 'bg-emerald-500/20 border-emerald-500/60 text-emerald-300 shadow-sm'
                      : 'bg-slate-900 border-slate-800 text-slate-400 hover:text-white hover:bg-slate-800'
                  }`}
                  id={`btn-hazard-pass-${h.id}`}
                >
                  <CheckCircle2 className="w-3 h-3 text-emerald-400" />
                  Pass
                </button>

                <button
                  type="button"
                  onClick={() => handleSetStatus(h.id, 'risk_detected')}
                  className={`flex-1 py-1 px-2 rounded-lg font-medium border transition-all cursor-pointer flex items-center justify-center gap-1 ${
                    status === 'risk_detected'
                      ? 'bg-amber-500/20 border-amber-500/60 text-amber-300 shadow-sm'
                      : 'bg-slate-900 border-slate-800 text-slate-400 hover:text-amber-300 hover:bg-slate-800'
                  }`}
                  id={`btn-hazard-risk-${h.id}`}
                >
                  <AlertTriangle className="w-3 h-3 text-amber-400" />
                  Risk
                </button>

                <button
                  type="button"
                  onClick={() => handleSetStatus(h.id, 'critical')}
                  className={`flex-1 py-1 px-2 rounded-lg font-bold border transition-all cursor-pointer flex items-center justify-center gap-1 ${
                    status === 'critical'
                      ? 'bg-rose-500/30 border-rose-500/70 text-rose-200 shadow-sm'
                      : 'bg-slate-900 border-slate-800 text-slate-400 hover:text-rose-300 hover:bg-slate-800'
                  }`}
                  id={`btn-hazard-critical-${h.id}`}
                >
                  <AlertOctagon className="w-3 h-3 text-rose-400" />
                  Critical
                </button>
              </div>
            </div>
          );
        })}
      </div>

      {flaggedHazards.length > 0 && (
        <div className="bg-gradient-to-r from-rose-950/40 via-amber-950/30 to-slate-950 border border-rose-500/40 rounded-2xl p-4 md:p-5 text-white space-y-3.5 shadow-xl animate-fadeIn">
          <div className="flex items-start justify-between gap-3">
            <div className="flex items-center gap-2.5">
              <div className="p-2 bg-rose-500/20 border border-rose-500/40 rounded-xl text-rose-400">
                <AlertOctagon className="w-5 h-5 animate-pulse" />
              </div>
              <div>
                <span className="text-[10px] font-mono font-bold tracking-wider text-rose-400 uppercase bg-rose-500/10 px-2 py-0.5 rounded border border-rose-500/30">
                  STATUTORY WARNING DIRECTIVE
                </span>
                <h4 className="text-sm font-bold text-white mt-0.5">
                  Immediate Corrective Action Required ({flaggedHazards.length} Risk Category Flagged)
                </h4>
              </div>
            </div>

            <span className="text-[10px] font-mono text-rose-300 bg-rose-950/60 border border-rose-800 px-2.5 py-1 rounded-lg shrink-0">
              SAFETY INDEX PENALTY: -{scorePenalty}%
            </span>
          </div>

          <div className="space-y-2 bg-slate-950/80 p-3 rounded-xl border border-slate-800/80 text-xs">
            {flaggedHazards.map(h => (
              <div key={h.id} className="flex items-start gap-2 text-slate-200">
                <span className={`text-[10px] font-mono font-bold px-1.5 py-0.5 rounded shrink-0 mt-0.5 border ${
                  hazardStates[h.id] === 'critical' 
                    ? 'bg-rose-500/20 border-rose-500/40 text-rose-300'
                    : 'bg-amber-500/20 border-amber-500/40 text-amber-300'
                }`}>
                  {h.code}
                </span>
                <div>
                  <span className="font-bold text-white">{h.name}: </span>
                  <span className="text-slate-300">{h.mitigationAction}</span>
                </div>
              </div>
            ))}
          </div>

          {onApplyCorrectiveActions && (
            <div className="flex justify-end pt-1">
              <button
                type="button"
                onClick={handleApplyActions}
                className="inline-flex items-center gap-2 text-xs font-bold px-4 py-2.5 bg-rose-500 hover:bg-rose-400 text-slate-950 rounded-xl transition-all cursor-pointer shadow-lg shadow-rose-950/40"
                id="btn-apply-corrective-actions"
                title="Append these corrective directives into the active inspection notes"
              >
                {copiedNotification ? (
                  <>
                    <Check className="w-4 h-4" />
                    <span>Corrective Actions Appended!</span>
                  </>
                ) : (
                  <>
                    <ArrowRight className="w-4 h-4" />
                    <span>Apply Corrective Directives to Audit Report</span>
                  </>
                )}
              </button>
            </div>
          )}
        </div>
      )}
    </div>
  );
};

export default WorkplaceHazardMatrix;
